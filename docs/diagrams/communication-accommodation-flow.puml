@startuml
title Stays4Pilgrims - Accommodation browsing and comments communication
hide footbox
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam dpi 190
skinparam maxMessageSize 22
skinparam sequence {
	ParticipantPadding 18
	BoxPadding 12
	MessageAlign center
	ArrowThickness 1
}

actor User
participant "Frontend" as FE
participant "Accommodation Ctrl" as AccommodationController
participant "Accommodation Svc" as AccommodationService
participant "Comments Ctrl" as CommentsController
participant "Comments Svc" as CommentsService
database "PostgreSQL" as DB

== Accommodation discovery ==

User -> FE : open home / Camino / detail
FE -> AccommodationController : handle(getall)
AccommodationController -> AccommodationService : findAll(page, limit)
AccommodationService -> DB : fetch accommodations
AccommodationController --> FE : accommodation list

User -> FE : filter by Camino
FE -> AccommodationController : handle(getbycamino)
AccommodationController -> AccommodationService : findByCamino(name)
AccommodationService -> DB : fetch filtered list
AccommodationController --> FE : filtered list

User -> FE : open Accommodation detail
FE -> AccommodationController : handle(getone)
AccommodationController -> AccommodationService : findOne(id, accountId)
AccommodationService -> DB : fetch detail + relations
AccommodationController --> FE : detail + gallery + services

== Comments and ratings ==

FE -> CommentsController : handle(list)
CommentsController -> CommentsService : listByAccommodation\n(id, page, limit)
CommentsService -> DB : fetch comments
CommentsController --> FE : comments + pagination

FE -> CommentsController : handle(exists)
CommentsController -> CommentsService : exists(accountId, id)
CommentsService -> DB : check if user already commented
CommentsController --> FE : { exists: true/false }

FE -> CommentsController : handle(getStats)
CommentsController -> CommentsService : getStats(id)
CommentsService -> DB : aggregate ratings
CommentsController --> FE : rating summary

@enduml
