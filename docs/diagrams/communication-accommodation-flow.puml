@startuml
title Stays4Pilgrims - Accomodation browsing and comments communication
hide footbox
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam dpi 190
skinparam maxMessageSize 22
skinparam sequence {
	ParticipantPadding 18
	BoxPadding 12
	MessageAlign center
	ArrowThickness 1
}

actor User
participant "Frontend" as FE
participant "Accomm Ctrl" as AccomodationsController
participant "Accomm Svc" as AccomodationsService
participant "Comments Ctrl" as CommentsController
participant "Comments Svc" as CommentsService
database "PostgreSQL" as DB

== Accommodation discovery ==

User -> FE : open home / Camino / detail
FE -> AccomodationsController : handle(getall)
AccomodationsController -> AccomodationsService : findAll(page, limit)
AccomodationsService -> DB : fetch accommodations
AccomodationsController --> FE : accommodation list

User -> FE : filter by Camino
FE -> AccomodationsController : handle(getbycamino)
AccomodationsController -> AccomodationsService : findByCamino(name)
AccomodationsService -> DB : fetch filtered list
AccomodationsController --> FE : filtered list

User -> FE : open Accomodation detail
FE -> AccomodationsController : handle(getone)
AccomodationsController -> AccomodationsService : findOne(id, accountId)
AccomodationsService -> DB : fetch detail + relations
AccomodationsController --> FE : detail + gallery + services

== Comments and ratings ==

FE -> CommentsController : handle(list)
CommentsController -> CommentsService : listByAccommodation\n(id, page, limit)
CommentsService -> DB : fetch comments
CommentsController --> FE : comments + pagination

FE -> CommentsController : handle(exists)
CommentsController -> CommentsService : exists(accountId, id)
CommentsService -> DB : check if user already commented
CommentsController --> FE : { exists: true/false }

FE -> CommentsController : handle(getStats)
CommentsController -> CommentsService : getStats(id)
CommentsService -> DB : aggregate ratings
CommentsController --> FE : rating summary

@enduml
