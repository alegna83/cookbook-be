@startuml
hide footbox
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam dpi 190
skinparam maxMessageSize 240
skinparam sequence {
  ParticipantPadding 14
  BoxPadding 8
  MessageAlign center
  ArrowThickness 1
}

actor Utilizador
participant "Frontend (Flutter)" as FE
participant "Backend (NestJS)" as BE
participant "AccommodationsModule" as AccommodationsModule
participant "CommentsModule" as CommentsModule
database "PostgreSQL" as DB

== Consulta de alojamentos ==

Utilizador -> FE : consultar lista geral
FE -> BE : POST /accommodations/handle
BE -> AccommodationsModule : handle(getall)
AccommodationsModule -> DB : findAll(page, limit)
AccommodationsModule --> FE : lista de alojamentos

Utilizador -> FE : filtrar por Caminho
FE -> BE : POST /accommodations/handle
BE -> AccommodationsModule : handle(getbycamino)
AccommodationsModule -> DB : findByCamino(name)
AccommodationsModule --> FE : lista filtrada

Utilizador -> FE : abrir detalhe do alojamento
FE -> BE : POST /accommodations/handle
BE -> AccommodationsModule : handle(getone)
AccommodationsModule -> DB : findOne(id, accountId)
AccommodationsModule --> FE : detalhe + galeria + serviços

note over FE,AccommodationsModule
  Os comentários são carregados ao abrir o detalhe.
end note

== Comentários e classificações ==

FE -> BE : POST /comments/handle
BE -> CommentsModule : handle(list)
CommentsModule -> DB : listByPlace(accommodationId, page, limit)
CommentsModule --> FE : comentários + paginação

FE -> BE : POST /comments/handle
BE -> CommentsModule : handle(exists)
CommentsModule -> DB : verificar se já comentou
CommentsModule --> FE : { exists: true/false }

FE -> BE : POST /comments/handle
BE -> CommentsModule : handle(getStats)
CommentsModule -> DB : agregar classificações
CommentsModule --> FE : resumo das classificações

== Pesquisa no mapa ==

Utilizador -> FE : consultar área visível do mapa
FE -> BE : POST /accommodations/handle
BE -> AccommodationsModule : handle(getbybounds)
AccommodationsModule -> DB : getByBounds(bounds)
AccommodationsModule --> FE : alojamentos no mapa

note over FE,AccommodationsModule
  A mesma operação cobre pesquisa noutra localização,
  alterando apenas os limites do mapa enviados.
end note

@enduml
