@startuml
hide footbox
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam dpi 190
skinparam maxMessageSize 200
skinparam sequence {
  ParticipantPadding 10
  BoxPadding 8
  MessageAlign center
  ArrowThickness 1
}

actor Utilizador
participant "Frontend (Flutter)" as FE
participant "Backend (NestJS)" as BE
participant "ContactModule" as ContactModule
participant "Serviço de e-mail" as Email

Utilizador -> FE : abrir página de contacto e preencher formulário
FE -> BE : POST /contact/send (dados do formulário)
BE -> ContactModule : send(dto)
ContactModule -> ContactModule : validar campos obrigatórios e dimensões

alt envio de e-mail ativo
  ContactModule -> Email : sendCustomEmail(receiverEmail, subject, html) para a equipa
  Email --> ContactModule : resultado do envio
  ContactModule --> BE : sucesso
  BE --> FE : 200 OK
else envio de e-mail desativado
  ContactModule -> Email : sendCustomEmail(receiverEmail, subject, html) para a equipa
  Email --> ContactModule : envio de e-mail desativado na configuração
  ContactModule --> BE : erro: envio indisponível
  BE --> FE : 500 Internal Server Error
end

FE --> Utilizador : mostrar mensagem de sucesso ou erro

@enduml