@startuml
hide footbox
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam dpi 190
skinparam maxMessageSize 200
skinparam sequence {
  ParticipantPadding 10
  BoxPadding 8
  MessageAlign center
  ArrowThickness 1
}

actor Utilizador
participant "Frontend (Flutter)" as FE
participant "Backend (NestJS)" as BE
participant "CommentsModule" as CommentsModule
participant "ContentModerationModule" as ModerationModule
participant "Serviço de IA (OpenRouter)" as AI
participant "Serviço de e-mail" as Email
database "PostgreSQL" as DB

Utilizador -> FE : escrever comentário e classificação e submeter
  FE -> BE : POST /comments/handle (add)
  BE -> CommentsModule : add(accommodationId, accountId, comment, rating)

CommentsModule -> DB : verificar se o alojamento existe
DB --> CommentsModule : alojamento encontrado / não encontrado
alt alojamento não encontrado
  CommentsModule --> BE : erro: alojamento não encontrado
  BE --> FE : 404 Not Found
else alojamento encontrado
  CommentsModule -> ModerationModule : moderar comentário
  ModerationModule -> AI : validar comentário
  AI --> ModerationModule : resultado da moderação

  alt moderação rejeitada
    ModerationModule --> CommentsModule : comentário rejeitado
    CommentsModule --> BE : erro: comentário rejeitado
    BE --> FE : 400 Bad Request
  else moderação aprovada
    CommentsModule -> DB : guardar comentário (estado pendente)
    DB --> CommentsModule : comentário guardado
    CommentsModule -> Email : notificar administrador
    Email --> CommentsModule : resultado do envio
    CommentsModule --> BE : comentário guardado
    BE --> FE : 201 Created (comentário pendente)
    FE --> Utilizador : mostrar comentário (pendente de aprovação)
  end
end

note over DB
Estados: pendente -> aprovado/rejeitado.
end note

@enduml

