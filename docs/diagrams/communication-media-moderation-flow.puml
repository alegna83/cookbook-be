@startuml
hide footbox
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam dpi 190
skinparam maxMessageSize 200
skinparam sequence {
  ParticipantPadding 10
  BoxPadding 6
  MessageAlign center
  ArrowThickness 1
}

actor Utilizador
actor Administrador
participant "Frontend (Flutter)" as FE
participant "Backend (NestJS)" as BE
participant "UploadsModule" as UploadsModule
participant "ContentModerationModule" as ModerationModule
participant "AccommodationsModule" as AccommodationsModule
participant "CommentsModule" as CommentsModule
participant "AuthModule" as AuthModule
participant "Serviço de IA (OpenRouter)" as AI
participant "Serviço de e-mail" as Email
database "PostgreSQL" as DB
participant "Cloudinary" as Cloudinary

== Carregamento de imagens ==

Utilizador -> FE : carregar imagem
FE -> BE : POST /upload
BE -> UploadsModule : uploadMedia(type, files)
UploadsModule -> ModerationModule : validar imagem
ModerationModule -> AI : validação automática
AI --> ModerationModule : permitir / rejeitar
ModerationModule --> UploadsModule : resultado
alt imagem aprovada
  UploadsModule -> Cloudinary : guardar ficheiro
  Cloudinary --> UploadsModule : URL pública
  UploadsModule --> FE : imagem carregada
else imagem rejeitada
  UploadsModule --> FE : erro de moderação
end

== Contribuição de conteúdo ==

alt comentários e fotografias
  Utilizador -> FE : submeter comentário / fotografia
  FE -> BE : POST /comments/handle ou POST /accommodations/handle
  alt comentário
    BE -> CommentsModule : add(...)
    CommentsModule -> ModerationModule : pedir validação
    ModerationModule -> AI : validação automática
    AI --> ModerationModule : permitir / rejeitar
    ModerationModule --> CommentsModule : resultado
    CommentsModule -> DB : guardar estado pendente
    CommentsModule -> Email : notificar administrador
    CommentsModule --> FE : submissão pendente
  else fotografia de alojamento
    BE -> AccommodationsModule : addGalleryPhotos(...)
    AccommodationsModule -> ModerationModule : pedir validação
    ModerationModule -> AI : validação automática
    AI --> ModerationModule : permitir / rejeitar
    ModerationModule --> AccommodationsModule : resultado
    AccommodationsModule -> DB : guardar estado pendente
    AccommodationsModule -> Email : notificar administrador
    AccommodationsModule --> FE : submissão pendente
  end
else novo alojamento / edição / remoção
  Utilizador -> FE : submeter alojamento ou pedido
  FE -> BE : POST /accommodations/handle
  BE -> AccommodationsModule : create / requestEdit / requestRemoval
  AccommodationsModule -> DB : guardar pedido pendente
  note right of AccommodationsModule
    Sem validação automática.
  end note
  AccommodationsModule -> Email : notificar administrador
  AccommodationsModule --> FE : pedido pendente
end

== Fila de moderação ==

Administrador -> FE : abrir fila de moderação
FE -> BE : POST /auth/admin/handle
BE -> AuthModule : getPending...
AuthModule -> DB : listar itens pendentes
AuthModule --> FE : fila de moderação

== Revisão e decisão ==

Administrador -> FE : aprovar ou rejeitar
FE -> BE : POST /auth/admin/handle
BE -> AuthModule : approve / reject
AuthModule -> DB : atualizar estado final
AuthModule -> Email : notificar utilizador
AuthModule --> FE : decisão registada

note over FE,BE
Detalhe técnico nas Figuras A.7, A.9 e A.10.
end note

@enduml
