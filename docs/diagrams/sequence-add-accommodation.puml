@startuml
scale 0.85
hide footbox
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam maxMessageSize 200
skinparam sequence {
  ParticipantPadding 10
  BoxPadding 8
  MessageAlign center
  ArrowThickness 1
}
actor Utilizador
participant "Frontend (Flutter)" as FE
participant "Backend (NestJS)" as API
participant "AccommodationsModule" as SVC
participant "ContentModerationModule" as MOD
participant "Serviço de IA" as AI
participant "Serviço de e-mail" as EMAIL
database "PostgreSQL" as DB

Utilizador -> FE: preencher formulário de novo alojamento
FE -> API: POST /accommodations/handle (create)
activate API
API -> SVC: create(dto)
activate SVC

opt fotografias
  SVC -> MOD: moderateImageUrls(galleryPhotoUrls)
  activate MOD
  MOD -> AI: pedir validação automática
  activate AI
  AI --> MOD: resultado
  deactivate AI
  MOD --> SVC: resultado
  deactivate MOD
  opt rejeitadas
    SVC --> API: erro (fotografias rejeitadas)
    deactivate SVC
    API --> FE: 400 Bad Request
    deactivate API
  end
end

opt categoria fornecida
  SVC -> DB: procurar categoria
  activate DB
  DB --> SVC: categoria ou nula
  deactivate DB
  opt não existe
    SVC --> API: 404 Not Found (categoria não encontrada)
    deactivate SVC
    API --> FE: 404 Not Found
    deactivate API
  end
end

SVC -> DB: guardar alojamento (pendente)
activate DB
DB --> SVC: alojamento guardado
deactivate DB

opt fotografias
  SVC -> DB: guardar fotografias (pendentes)
  activate DB
  DB --> SVC: fotografias guardadas
  deactivate DB
end

SVC -> DB: obter alojamento completo
activate DB
DB --> SVC: alojamento com relações
deactivate DB

SVC -> EMAIL: notificar administrador

SVC --> API: 201 Created (pendente de aprovação)
deactivate SVC
API --> FE: 201 Created (pendente de aprovação)
deactivate API

note over MOD,DB: Só as fotografias passam pela validação automática; o alojamento e as fotografias ficam pendentes até à decisão do administrador.

@enduml

