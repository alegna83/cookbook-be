@startuml
title Add Accommodation (create) sequence
scale 0.85
hide footbox
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam maxMessageSize 55
skinparam sequence {
  ParticipantPadding 10
  BoxPadding 8
  MessageAlign center
  ArrowThickness 1
}
actor User
participant "Stays4Pilgrims Frontend" as FE
participant "Stays4Pilgrims Backend - AccommodationController" as API
participant "AccommodationService" as SVC
participant "ContentModerationService" as MOD
participant "CategoryRepo / DB" as CATDB
participant "AccommodationRepo / DB" as ADB
participant "GalleryPhotoRepo / DB" as GDB

User -> FE: Fill "Add Accommodation" form\n(data + main_photo + gallery_photos)
FE -> API: POST /Accommodations/handle\n{action:'create', payload:CreateAccommodationDto}
activate API
API -> SVC: create(CreateAccommodationDto)
activate SVC
alt gallery_photos present
  SVC -> MOD: moderateImageUrls(galleryPhotoUrls)
  activate MOD
  MOD --> SVC: moderation result (allow/reject)
  deactivate MOD
  alt moderation rejected
    SVC --> API: throw BadRequest (images rejected)
    deactivate SVC
    API --> FE: 400 Bad Request
    deactivate API
    return
  end
end

alt Accommodation_category provided
  SVC -> CATDB: find category by id or name
  activate CATDB
  CATDB --> SVC: category or not found
  deactivate CATDB
end

SVC -> ADB: save new Accommodation\n(main_photo normalized)
activate ADB
ADB --> SVC: saved Accommodation id
deactivate ADB

alt gallery_photos present
  SVC -> GDB: save gallery photos as status='pending'
  activate GDB
  GDB --> SVC: saved gallery entries
  deactivate GDB
end

SVC -> ADB: findOne with relations\n(gallery_photos, category, prices)
activate ADB
ADB --> SVC: full saved entity
deactivate ADB

SVC --> API: return created AccommodationDto
deactivate SVC
API --> FE: 200 OK {AccommodationDto}
deactivate API

note over FE,GDB: Gallery photos start as pending\nand are approved/rejected later

@enduml

