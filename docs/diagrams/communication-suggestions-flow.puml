@startuml
title Stays4Pilgrims - Suggestions and recommendation communication
hide footbox
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam dpi 190
skinparam maxMessageSize 22
skinparam sequence {
  ParticipantPadding 18
  BoxPadding 12
  MessageAlign center
  ArrowThickness 1
}

actor User
participant "Frontend" as FE
participant "Sug Ctrl" as SuggestionController
participant "Sug Svc" as SuggestionService
participant "Accommodation Svc" as AccommodationService
participant "Com Svc" as CommentsService
database "PostgreSQL" as DB
participant "OpenRouter / OpenAI" as AI

== Nearby text suggestions ==

User -> FE : open home near location
FE -> FE : read coordinates + interest

User -> FE : open nearby suggestions
FE -> SuggestionController : sugerir(body)
SuggestionController -> SuggestionService : sugerirLugares(...)
SuggestionService -> AI : chat completion\n(nearby + interest)
AI --> SuggestionService : 3 text suggestions
SuggestionController --> FE : suggestions response
FE --> User : show suggestions notification and dialog

== Best accommodation recommendation ==

User -> FE : request best Accommodation recommendation
note over FE
Best accommodation trigger
is shown only for authenticated users.
end note
FE -> SuggestionController : bestAccommodation(lat, lon, radius, category)
SuggestionController -> SuggestionService : suggestBestAccommodation(...)
SuggestionService -> AccommodationService : getByBounds(bounds)
AccommodationService -> DB : fetch approved in area
SuggestionService -> CommentsService : use ratings + counts
CommentsService -> DB : aggregate comment statistics
alt enough local rating data
  SuggestionService -> AI : optional ranking analysis
  AI --> SuggestionService : recommended option or reasoning
else fallback to best local option
  SuggestionService -> SuggestionService : rank by reviews + ratings
end
SuggestionController --> FE : JSON recommendation payload
FE --> User : show best Accommodation popup

@enduml
