@startuml
scale 0.88
left to right direction
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam componentStyle rectangle
skinparam component {
  Padding 8
}
skinparam ArrowThickness 1
skinparam nodesep 18
skinparam ranksep 18

component "Frontend (Flutter)" as FE
component "Backend (NestJS)" as BE

FE --> BE : Pedidos HTTPS/REST

note bottom of FE
  Fluxos detalhados:
  Figuras B.2 a B.6
end note

note bottom of BE
  Grupos de API:
  /auth
  /auth/admin/handle
  /accounts
  /caminos
  /accommodations
  /stages
  /comments
  /favorites
  /statistics
  /suggestions
  /upload
  /contact
  /ai-chat
end note

@enduml
