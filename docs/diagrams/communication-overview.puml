@startuml
title Stays4Pilgrims - Frontend and backend communication overview
scale 0.85
left to right direction
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam componentStyle rectangle
skinparam component {
  Padding 8
}
skinparam ArrowThickness 1

component "Stays4Pilgrims Frontend" as FE
component "Stays4Pilgrims Backend" as BE

FE --> BE : Auth
FE --> BE : Accommodation browsing
FE --> BE : Comments
FE --> BE : Favorites / Suggestions
FE --> BE : Uploads
FE --> BE : Account updates
FE --> BE : Contact form
FE --> BE : Moderation actions
FE --> BE : AI chat

note bottom of FE
  Detailed flows:
  - communication-auth-flow
  - communication-accommodation-flow
  - communication-suggestions-flow
  - communication-media-moderation-flow
  - communication-contact-flow
end note

note bottom of BE
  Main API groups:
  /auth
  /accounts
  /accommodations
  /comments
  /favorites
  /suggestions
  /upload
  /contact
  /ai-chat
end note

@enduml
