@startuml
top to bottom direction
scale 1300 width
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam linetype ortho
skinparam shadowing false
skinparam dpi 220
skinparam packageStyle rectangle
skinparam packageBorderStyle dashed
skinparam packageBorderColor #444444
skinparam packageBackgroundColor transparent
skinparam componentStyle rectangle
skinparam legendFontSize 8
skinparam nodesep 24
skinparam ranksep 48
skinparam ArrowFontOffset 90
skinparam package {
	Padding 15
}

component "App (Flutter)" as APP #E5E5E5
component "REST API (NestJS)" as API #E5E5E5

package "Backend (NestJS)" as BACKEND {
	component "CommentsModule\nFavoritesModule\nUploadModule" as MODULE_A #E5E5E5
	component "AccommodationsModule\nAccommodationCategoriesModule" as MODULE_B #E5E5E5
	component "CaminosModule\nStagesModule\nStatisticsCaminosModule" as MODULE_C #E5E5E5
	component "AuthModule\nAccountsModule" as MODULE_D #E5E5E5

	component "SuggestionModule" as MODULE_E #E5E5E5
	component "ContentModerationModule" as MODULE_F #E5E5E5
	component "ContactModule" as MODULE_G #E5E5E5

	MODULE_A -[hidden]right-> MODULE_B
	MODULE_B -[hidden]right-> MODULE_C
	MODULE_C -[hidden]right-> MODULE_D

	MODULE_C -[hidden]down-> MODULE_E
	MODULE_D -[hidden]down-> MODULE_F
	MODULE_F -[hidden]down-> MODULE_G
}

cloud "Cloudinary" as CLOUDINARY #E5E5E5
database "PostgreSQL" as DB #E5E5E5
cloud "AI Service" as AI #E5E5E5
cloud "Email Service" as EMAIL #E5E5E5

APP -[hidden]down-> API
API -[hidden]down-> BACKEND

CLOUDINARY -[hidden]right-> DB
DB -[hidden]down-> AI
AI -[hidden]down-> EMAIL

APP --> API : \nHTTP/JSON requests
API --> BACKEND : \nmodule routing

BACKEND <--> DB : \nread/write via\nTypeORM
MODULE_A --> CLOUDINARY : \nimage upload
MODULE_E --> AI : \nsuggestions and\nrecommendations
MODULE_F --> AI : \nautomated content checks\n(comments/photos only)
MODULE_D --> EMAIL : \nregistration confirmation
MODULE_F --> EMAIL : \nmoderation result\nnotification
MODULE_G --> EMAIL : \ncontact\nmessages

@enduml