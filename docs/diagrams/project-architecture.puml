@startuml
title Stays4Pilgrims - Project Architecture Overview

top to bottom direction
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam linetype ortho
skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle
skinparam dpi 180
skinparam package {
  Padding 20
}
skinparam nodesep 55
skinparam ranksep 70

actor User

component "Stays4Pilgrims Frontend\n(Web / Mobile)" as FE

package "Stays4Pilgrims Backend (NestJS)" as BE {
  component "Auth\nAccounts" as AUTH
  component "Accommodation\nmodule" as ACC
  component "Caminos\nStages\nStatistics" as ROUTES
  component "Comments\nFavorites\nSuggestions" as SOCIAL
  component "AI Chat" as AI_CHAT
  component "Upload" as UPLOAD
  component "Content\nModeration" as MOD
  component "Contact" as CONTACT
}

database "PostgreSQL\n(managed / Supabase)" as DB
cloud "Media Storage\n(Cloudinary)" as CLOUDINARY
cloud "Email Provider\n(Resend/SMTP)" as EMAIL
cloud "AI Moderation\n(optional)" as OPENAI

User --> FE : browse / submit content
FE --> BE : HTTPS REST API

AUTH -[hidden]down-> ACC
ACC -[hidden]down-> ROUTES
ROUTES -[hidden]down-> SOCIAL
SOCIAL -[hidden]down-> UPLOAD
UPLOAD -[hidden]down-> AI_CHAT
AI_CHAT -[hidden]down-> MOD
MOD -[hidden]down-> CONTACT

AUTH --> DB : accounts, sessions
ACC --> DB : places, categories, requests
ROUTES --> DB : caminos, stages, stats
SOCIAL --> DB : comments, favorites
AI_CHAT --> DB : read-only domain lookups
UPLOAD --> CLOUDINARY : media upload/delete
MOD --> OPENAI : moderation checks
AUTH --> EMAIL : auth emails
ACC --> EMAIL : moderation emails
SOCIAL --> EMAIL : review notifications
CONTACT --> EMAIL : contact delivery
AI_CHAT --> OPENAI : chat completions / fallback

note right of BE
  Core backend domains in AppModule.
  Each module encapsulates controllers,
  services and data access.
end note

note bottom of FE
  Single client for all user interactions.
  Consumes API and renders map-driven UI.
end note

@enduml
