@startuml
top to bottom direction
scale 1.0

skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam packageBorderStyle dashed
skinparam packageBorderColor #444444
skinparam packageBackgroundColor transparent
skinparam package {
	Padding 10
}
skinparam componentStyle rectangle

actor User

package "Interface Layer" as L1 {
	component "UI Screens\nMap, Detail, Account, Auth" as UI
}

package "State Management Layer" as L2 {
	component "State Management\nflutter_bloc / Cubit" as State
}

package "Client Layer" as L3 {
	component "Services and API Client" as Client
}

package "Local Persistence Layer" as L4 {
	component "Local Storage\nAuth + Consent" as Storage
}

package "Stays4Pilgrims Backend API" as BACKEND {
	component "Backend API" as API
}

User --> UI : interage
UI --> State : ações do utilizador
State --> UI : atualizações de estado
State --> Client : carregar / submeter dados
State <--> Storage : persistir / restaurar sessão
Client --> API : HTTP/REST
@enduml
