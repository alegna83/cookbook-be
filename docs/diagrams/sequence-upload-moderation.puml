@startuml
scale 0.85
hide footbox
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam maxMessageSize 200
skinparam sequence {
  ParticipantPadding 10
  BoxPadding 8
  MessageAlign center
  ArrowThickness 1
}
actor Utilizador
participant "Frontend (Flutter)" as FE
participant "Backend (NestJS)" as API
participant "UploadModule" as UP
participant "ContentModerationModule" as MOD
participant "Serviço de IA (OpenRouter)" as AI
participant "Cloudinary" as Cloudinary
database "PostgreSQL" as DB

Utilizador -> FE: selecionar imagem e submeter
FE -> API: POST /upload (multipart)
activate API
API -> UP: uploadMedia(type, files)
activate UP
UP -> MOD: moderateImageBuffers(files)
activate MOD
MOD -> AI: validação automática
activate AI
AI --> MOD: permitir / rejeitar
deactivate AI
MOD --> UP: resultado
deactivate MOD
alt imagem aprovada
  UP -> Cloudinary: guardar ficheiro
  Cloudinary --> UP: URL pública
  UP -> MOD: moderateImageUrls([url])
  activate MOD
  MOD -> AI: validação automática
  activate AI
  AI --> MOD: permitir / rejeitar
  deactivate AI
  MOD --> UP: resultado
  deactivate MOD
  alt imagem aprovada
    UP -> DB: guardar fotografia (pendente)
    activate DB
    DB --> UP: fotografia guardada
    deactivate DB
    UP --> API: URL pública + estado pendente
    API --> FE: 200 OK (pendente)
  else imagem rejeitada
    UP -> Cloudinary: apagar ficheiro
    Cloudinary --> UP: ficheiro apagado
    UP --> API: 400 Bad Request (imagem rejeitada)
    API --> FE: 400 Bad Request (imagem rejeitada)
  end
else imagem rejeitada
  UP --> API: 400 Bad Request (imagem rejeitada)
  API --> FE: 400 Bad Request (imagem rejeitada)
end
deactivate UP
deactivate API

note over MOD,DB: Só as fotografias passam pela validação automática; a validação é repetida sobre a URL pública antes de guardar; a decisão do administrador sobre a fotografia é tomada através de /auth/admin/handle (Figura B.5b).

@enduml

