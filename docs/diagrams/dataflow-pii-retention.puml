@startuml

left to right direction
scale 0.9
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam packageTitleFontSize 12
skinparam componentStyle rectangle
skinparam nodesep 28
skinparam ranksep 38

skinparam package {
  Padding 10
}

skinparam note {
  FontSize 10
  Padding 6
}

package "Sistema Stays4Pilgrims" {
  package "Aplicação Flutter/Web" as Frontend {
    queue "Entrada do utilizador" as FE_INPUT
  }

  package "Backend NestJS" as Backend {
    component "Módulos do backend\nAuthModule, AccountsModule,\nAccommodationsModule, CommentsModule,\nUploadModule, ContactModule" as BACKEND_MODULES
  }

  package "Serviços externos" {
    queue "Serviço de e-mail" as EMAIL_SVC
    queue "Serviço de moderação de conteúdo\n(IA)" as MODERATION
    queue "Cloudinary" as CLOUDINARY
  }

  database "PostgreSQL" as DB {
    entity "Account\n(id, email, password,\nname, isEmailVerified,\nemailVerificationToken,\nemailVerificationTokenExpiry)" as TBL_ACC
    entity "Accommodation\n(id, accommodation_name, address,\nphone, email, website,\naccount_id, status)" as TBL_PLACES
    entity "Comment\n(id, text, rating,\naccount_id, accommodation_id,\nstatus, created_at)" as TBL_COMMENTS
    entity "GalleryPhoto\n(id, photo_url, account_id,\naccommodation_id, status, created_at)" as TBL_GALLERY
  }
}

FE_INPUT --> BACKEND_MODULES

BACKEND_MODULES --> TBL_ACC
BACKEND_MODULES --> TBL_PLACES
BACKEND_MODULES --> TBL_COMMENTS
BACKEND_MODULES --> TBL_GALLERY
BACKEND_MODULES --> EMAIL_SVC
BACKEND_MODULES --> MODERATION
BACKEND_MODULES --> CLOUDINARY

@enduml

