@startuml
hide footbox
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam dpi 190
skinparam maxMessageSize 200
skinparam sequence {
	ParticipantPadding 18
	BoxPadding 12
	MessageAlign center
	ArrowThickness 1
}

actor Utilizador
participant "Frontend (Flutter)" as FE
participant "Backend (NestJS)" as BE
participant "AuthModule" as AuthModule
participant "AccountsModule" as AccountsModule
database "PostgreSQL" as DB
participant "Serviço de e-mail" as Email

== Registo e verificação ==

Utilizador -> FE : registo
FE -> BE : POST /auth/register
BE -> AuthModule : register(...)
AuthModule -> AccountsModule : register(...)
AccountsModule -> DB : criar conta + hash da palavra-passe
AccountsModule -> Email : enviar e-mail de verificação
BE --> FE : 201 Created + dados da conta

Utilizador -> FE : verificar e-mail
FE -> BE : POST /auth/verify-email
BE -> AuthModule : verifyEmail(token)
AuthModule -> AccountsModule : verifyEmail(token)
AccountsModule -> DB : marcar e-mail verificado
BE --> FE : 200 OK

note right of AccountsModule
	Token de verificação: 24 h
end note

== Início de sessão ==

Utilizador -> FE : iniciar sessão
FE -> BE : POST /auth/login
BE -> AuthModule : login(email, password)
AuthModule -> AccountsModule : procurar conta por e-mail
AccountsModule -> DB : procurar conta
DB --> AccountsModule : conta encontrada
AccountsModule --> AuthModule : conta
AuthModule -> AuthModule : verificar palavra-passe
AuthModule --> BE : JWT / dados de sessão
BE --> FE : JWT / dados de sessão

== Recuperação de palavra-passe ==

Utilizador -> FE : pedir recuperação de palavra-passe
FE -> BE : POST /auth/request-password-reset
BE -> AuthModule : requestPasswordReset(email)
AuthModule -> AccountsModule : requestPasswordReset(email)
AccountsModule -> DB : criar token de recuperação
AccountsModule -> Email : enviar e-mail de recuperação
BE --> FE : 200 OK

Utilizador -> FE : definir nova palavra-passe
FE -> BE : POST /auth/reset-password
BE -> AuthModule : resetPassword(token, newPassword)
AuthModule -> AccountsModule : resetPassword(token, newPassword)
AccountsModule -> DB : atualizar hash da palavra-passe
BE --> FE : 200 OK

note right of AccountsModule
  Token de recuperação: 1 h
end note

@enduml